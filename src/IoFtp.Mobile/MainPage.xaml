<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IoFtp.Mobile.MainPage"
             Title="FluxFTP">
    <NavigationPage.TitleView>
        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
            <Label Text="Flux"
                   TextColor="{StaticResource AccentColor}"
                   FontAttributes="Bold"
                   FontSize="20" />
            <Label Text="FTP"
                   TextColor="{StaticResource TextColor}"
                   FontAttributes="Bold"
                   FontSize="20" />
        </HorizontalStackLayout>
    </NavigationPage.TitleView>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="8" RowSpacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
            <Button x:Name="SiteButton"
                    Text="Sites"
                    TextColor="{StaticResource AccentColor}"
                    Padding="10,7"
                    FontSize="13"
                    Clicked="OnChooseSite" />
            <Label Grid.Column="1"
                   x:Name="SelectedSiteLabel"
                   Text="Ingen site vald"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Grid.Column="2"
                    x:Name="ConnectButton"
                    Text="Anslut"
                    Padding="10,7"
                    FontSize="13"
                    IsEnabled="False"
                    Clicked="OnConnect" />
            <Button Grid.Column="3"
                    x:Name="ViewModeButton"
                    Text="Dualvy"
                    Padding="10,7"
                    FontSize="13"
                    Clicked="OnToggleViewMode" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="3">
            <Label Text="Server"
                   FontSize="11"
                   VerticalOptions="Center"
                   TextColor="{StaticResource MutedTextColor}" />
            <Button Grid.Column="1" Text="‹" Padding="8,6" FontSize="14" Clicked="OnRemoteBack" />
            <Button Grid.Column="2" Text="›" Padding="8,6" FontSize="14" Clicked="OnRemoteForward" />
            <Entry Grid.Column="3"
                   x:Name="RemotePath"
                   Text="/"
                   Placeholder="Fjärrmapp"
                   ReturnType="Go"
                   FontSize="13"
                   Completed="OnRemotePathCompleted" />
            <Button Grid.Column="4"
                    Text="↑"
                    Padding="12,6"
                    FontSize="16"
                    Clicked="OnRemoteUp" />
            <Button Grid.Column="5"
                    Text="Öppna"
                    Padding="9,6"
                    FontSize="12"
                    Clicked="OnOpenRemote" />
        </Grid>

        <Grid Grid.Row="2"
              x:Name="PaneGrid"
              ColumnDefinitions="*,*"
              ColumnSpacing="7">
            <Grid x:Name="LocalPane" RowDefinitions="Auto,Auto,*" RowSpacing="3">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="3">
                    <Label Text="LOKALT"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Sortera" Padding="7,5" FontSize="10" Clicked="OnSortLocal" />
                    <Button Grid.Column="2"
                            Text="Filer"
                            Padding="8,5"
                            FontSize="11"
                            Clicked="OnPickFiles" />
                    <Button Grid.Column="3"
                            Text="Startmapp"
                            Padding="8,5"
                            FontSize="11"
                            Clicked="OnPickFolder" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="2">
                    <Button Text="‹" Padding="8,4" FontSize="14" Clicked="OnLocalBack" />
                    <Button Grid.Column="1" Text="›" Padding="8,4" FontSize="14" Clicked="OnLocalForward" />
                    <Button Grid.Column="2" Text="↑" Padding="8,4" FontSize="14" Clicked="OnLocalUp" />
                    <Button Grid.Column="3" Text="↻" Padding="8,4" FontSize="14" Clicked="OnLocalRefresh" />
                    <Label Grid.Column="4"
                           x:Name="LocalPathLabel"
                           Text="Ingen lokal mapp vald"
                           FontSize="10"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalOptions="Center"
                           LineBreakMode="HeadTruncation" />
                </Grid>
                <CollectionView Grid.Row="2"
                                x:Name="LocalFiles"
                                SelectionMode="Multiple"
                                SelectionChanged="OnLocalSelectionChanged">
                    <CollectionView.EmptyView>
                        <Label Text="Välj en startmapp för att bläddra, eller välj fristående filer."
                               Padding="6"
                               FontSize="12"
                               TextColor="Gray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,7" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="{Binding Icon}" FontSize="15" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding FileName}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayPath}"
                                       FontSize="9"
                                       TextColor="{StaticResource MutedTextColor}"
                                       LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding SizeText}" FontSize="9"
                                       TextColor="{StaticResource MutedTextColor}" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="1"
                  x:Name="RemotePane"
                  RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <Label Text="FJÄRRSERVER"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Sortera" Padding="7,5" FontSize="10" Clicked="OnSortRemote" />
                    <Button Grid.Column="2" Text="★" Padding="9,5" FontSize="12" Clicked="OnBookmarks" />
                    <Label Grid.Column="3"
                           x:Name="ViewModeLabel"
                           Text="SINGEL"
                           FontSize="10"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalOptions="Center" />
                </Grid>
                <CollectionView Grid.Row="1"
                                x:Name="RemoteFiles"
                                SelectionMode="Multiple">
                    <CollectionView.EmptyView>
                        <Label Text="Välj en site och anslut för att visa serverns filer."
                               Padding="8"
                               FontSize="12"
                               TextColor="{StaticResource MutedTextColor}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="7,8"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="7">
                                <Label Text="{Binding Icon}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding SizeText}" FontSize="10"
                                           TextColor="{StaticResource MutedTextColor}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding ModifiedText}" FontSize="8"
                                           TextColor="{StaticResource MutedTextColor}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="6">
            <Button Text="Ladda upp →"
                    Padding="10,7"
                    FontSize="12"
                    Clicked="OnUpload" />
            <Button Grid.Column="1"
                    Text="← Ladda ner"
                    Padding="10,7"
                    FontSize="12"
                    Clicked="OnDownload" />
        </Grid>
        <Border Grid.Row="4"
                BackgroundColor="{StaticResource SurfaceRaisedColor}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Padding="8,5">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="7"
                  RowSpacing="4">
                <ActivityIndicator x:Name="StatusActivity"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   IsRunning="False"
                                   VerticalOptions="Center" />
                <Label Grid.Column="1"
                       x:Name="StatusText"
                       Text="Inte ansluten"
                       FontSize="10"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       x:Name="SpeedText"
                       Text="0 B/s"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AccentColor}"
                       VerticalOptions="Center" />
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="3"
                             x:Name="TransferProgress"
                             HeightRequest="4"
                             Progress="0" />
                <Label Grid.Row="2"
                       Grid.ColumnSpan="3"
                       x:Name="TimingText"
                       Text="Förfluten: —  •  Kvar: —"
                       FontSize="9"
                       TextColor="{StaticResource MutedTextColor}"
                       HorizontalOptions="End" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
