<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IoFtp.Mobile.MainPage"
             Title="FluxFTP">
    <NavigationPage.TitleView>
        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
            <Label Text="Flux"
                   TextColor="{StaticResource AccentColor}"
                   FontAttributes="Bold"
                   FontSize="20" />
            <Label Text="FTP"
                   TextColor="{StaticResource TextColor}"
                   FontAttributes="Bold"
                   FontSize="20" />
        </HorizontalStackLayout>
    </NavigationPage.TitleView>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="8" RowSpacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
            <Button x:Name="SiteButton"
                    Text="Sites"
                    TextColor="{StaticResource AccentColor}"
                    Padding="10,7"
                    FontSize="13"
                    Clicked="OnChooseSite" />
            <Label Grid.Column="1"
                   x:Name="SelectedSiteLabel"
                   Text="Ingen site vald"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Grid.Column="2"
                    x:Name="ConnectButton"
                    Text="Anslut"
                    Padding="10,7"
                    FontSize="13"
                    IsEnabled="False"
                    Clicked="OnConnect" />
            <Button Grid.Column="3"
                    x:Name="ViewModeButton"
                    Text="Dualvy"
                    Padding="10,7"
                    FontSize="13"
                    Clicked="OnToggleViewMode" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
            <Label Text="Server"
                   FontSize="11"
                   VerticalOptions="Center"
                   TextColor="{StaticResource MutedTextColor}" />
            <Entry Grid.Column="1"
                   x:Name="RemotePath"
                   Text="/"
                   Placeholder="Fjärrmapp"
                   ReturnType="Go"
                   FontSize="13"
                   Completed="OnRemotePathCompleted" />
            <Button Grid.Column="2"
                    Text="↑"
                    Padding="12,6"
                    FontSize="16"
                    Clicked="OnRemoteUp" />
            <Button Grid.Column="3"
                    Text="Öppna"
                    Padding="9,6"
                    FontSize="12"
                    Clicked="OnOpenRemote" />
        </Grid>

        <Grid Grid.Row="2"
              x:Name="PaneGrid"
              ColumnDefinitions="*,*"
              ColumnSpacing="7">
            <Grid x:Name="LocalPane" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="3">
                    <Label Text="LOKALT"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Filer"
                            Padding="8,5"
                            FontSize="11"
                            Clicked="OnPickFiles" />
                    <Button Grid.Column="2"
                            Text="Mapp"
                            Padding="8,5"
                            FontSize="11"
                            Clicked="OnPickFolder" />
                </Grid>
                <CollectionView Grid.Row="1"
                                x:Name="LocalFiles"
                                SelectionMode="Multiple">
                    <CollectionView.EmptyView>
                        <Label Text="Välj filer eller en mapp för uppladdning."
                               Padding="6"
                               FontSize="12"
                               TextColor="Gray" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Padding="6,7" Spacing="1">
                                <Label Text="{Binding FileName}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayPath}"
                                       FontSize="9"
                                       TextColor="{StaticResource MutedTextColor}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Column="1"
                  x:Name="RemotePane"
                  RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="FJÄRRSERVER"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="ViewModeLabel"
                           Text="SINGEL"
                           FontSize="10"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalOptions="Center" />
                </Grid>
                <CollectionView Grid.Row="1"
                                x:Name="RemoteFiles"
                                SelectionMode="Multiple">
                    <CollectionView.EmptyView>
                        <Label Text="Välj en site och anslut för att visa serverns filer."
                               Padding="8"
                               FontSize="12"
                               TextColor="{StaticResource MutedTextColor}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="7,8"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="7">
                                <Label Text="{Binding Icon}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2"
                                       Text="{Binding SizeText}"
                                       FontSize="10"
                                       TextColor="{StaticResource MutedTextColor}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,*"
              ColumnSpacing="6">
            <Button Text="Ladda upp →"
                    Padding="10,7"
                    FontSize="12"
                    Clicked="OnUpload" />
            <Button Grid.Column="1"
                    Text="← Ladda ner"
                    Padding="10,7"
                    FontSize="12"
                    Clicked="OnDownload" />
            <ProgressBar Grid.Row="1"
                         Grid.ColumnSpan="2"
                         x:Name="TransferProgress"
                         Margin="0,4,0,0" />
        </Grid>
    </Grid>
</ContentPage>
